--- sched.c.orig	2025-01-05 13:14:08.000000000 +0900
+++ sched.c	2025-06-29 14:55:00.045394240 +0900
@@ -589,6 +589,34 @@
 	nvgpu_mutex_release(&sched->status_lock);
